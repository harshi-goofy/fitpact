// FitPact — data model
//
// Redesign notes (Aug 2026):
//   - Walk and Run were dropped. A day is Swim / Gym / Diet, nothing else.
//   - Rest and cheat days are no longer stored flags or spendable tokens.
//     Every Sunday is a rest day and the 2nd + 4th Sunday of the month are
//     also cheat days. Both are derived from the calendar in src/lib/rules.ts,
//     so they can never drift out of sync with the entries.
//   - Weight now has a plan: startWeightKg -> goalWeightKg by goalDate, with
//     per-month checkpoints back-calculated from that straight line.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRACKER
  PARTNER
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  role      Role
  // SHA-256 of a 4-digit PIN. No login provider for a two-person app; the PIN
  // exists so the tracker cannot tick the partner's confirmation boxes.
  pinHash   String?
  createdAt DateTime   @default(now())
  entries   DayEntry[]
  comments  Comment[]
}

model DayEntry {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date // date-only, resolved in APP_TIMEZONE

  // The three things a day is made of. The streak needs dietDone AND
  // (swimDone OR gymDone); Sundays are satisfied automatically.
  swimDone Boolean @default(false)
  gymDone  Boolean @default(false)
  dietDone Boolean @default(false)

  // Partner confirmation. What the tracker logs is provisional until the
  // partner ticks it off; only confirmed days count toward the streak and the
  // calendar. Unconfirmed days expire once the 24h window closes.
  moveConfirmedAt DateTime?
  dietConfirmedAt DateTime?

  note      String?  @db.VarChar(280)
  photo     Bytes?
  photoMime String?
  weightKg  Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model Comment {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String   @db.VarChar(500)
  // A cheer is a one-tap appreciation rather than a written note. Same table,
  // because it is still "someone said something about this day".
  cheer     Boolean  @default(false)
  seenAt    DateTime?
  createdAt DateTime @default(now())

  @@index([date])
  @@index([seenAt])
}

model Nudge {
  id         String    @id @default(cuid())
  fromUserId String
  date       DateTime  @db.Date
  seenAt     DateTime?
  sentAt     DateTime  @default(now())

  @@unique([fromUserId, date]) // one nudge per person per day
}

model Settings {
  id       String @id @default("singleton")
  timezone String @default("Asia/Kolkata")

  // Monthly session targets driving the progress bars on Today.
  monthlySwimTarget Int @default(16)
  monthlyGymTarget  Int @default(20)
  monthlyDietTarget Int @default(28)

  // The weight plan. Checkpoints are derived, never stored.
  startWeightKg Float    @default(88)
  goalWeightKg  Float    @default(78)
  goalDate      DateTime @db.Date

  whyNote   String?
  startDate DateTime @db.Date
}

model Milestone {
  id      String   @id @default(cuid())
  kind    String
  shownAt DateTime @default(now())

  @@unique([kind])
}
