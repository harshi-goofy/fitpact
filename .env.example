# Neon Postgres — pooled connection string
# Get this from your Neon project dashboard → Connection Details → Pooled connection
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_random_hex_string

# Generate with: openssl rand -hex 32
CRON_SECRET=replace_with_another_random_hex_string

# Get from resend.com after creating an account
RESEND_API_KEY=re_xxxxxxxxxxxx

# Timezone for "today" logic — change if not in India
APP_TIMEZONE=Asia/Kolkata
